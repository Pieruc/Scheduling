# Configurazione in sviluppo (npm run dev).
VITE_API_URL=/api/v1

# true = backend finto (MSW) nel browser; false = tutto sul backend vero (Spring su localhost:8080)
VITE_USE_MOCKS=true

# Con i mock accesi, aree da mandare comunque al backend vero, separate da virgola:
# auth, config, orders, planning, operator, models, audit  (oppure "all").
# Se ce n'è almeno una, anche "auth" va sul backend vero (servono i suoi token).
# Per le prove locali conviene sovrascriverla in .env.development.local (non versionato).
VITE_REAL_AREAS=
